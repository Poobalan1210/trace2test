{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@trace2test/sdk": [
        "./packages/sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "services/*/src",
    "scripts/*.ts"
  ]
}
