{
  "name": "trace2test",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "validate": "sam validate --lint",
    "local:pipeline": "tsx scripts/local-pipeline.ts",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "local:stack": "tsx scripts/local-stack.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/regression/**/*.test.js"
    ],
    "testEnvironment": "node"
  }
}
