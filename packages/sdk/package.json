{
  "name": "@trace2test/sdk",
  "version": "0.1.0",
  "description": "Capture failed HTTP requests in production, redacted inside your service, so Trace2Test can replay them on staging and write a regression test.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Poobalan1210/trace2test.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Poobalan1210/trace2test#readme",
  "bugs": {
    "url": "https://github.com/Poobalan1210/trace2test/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lambda",
    "express",
    "fastify",
    "regression-test",
    "redaction",
    "incident",
    "replay"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@t2t/shared": "*",
    "@types/express": "^4.17.25",
    "express": "^4.22.3",
    "fastify": "^5.12.8",
    "tsup": "^8.5.1"
  }
}
